NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://resource_portal:resource_portal@localhost:5433/resource_portal?schema=public
AUTH_MODE=dev
PUBLIC_API_URL=http://localhost:3000
AUTH_SESSION_COOKIE_NAME=rp_session
AUTH_CSRF_COOKIE_NAME=rp_csrf
AUTH_SESSION_TTL_SECONDS=3600
AUTH_SESSION_IDLE_TIMEOUT_SECONDS=1800
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SECRET=
OIDC_ISSUER_URL=http://localhost:8080
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=
OIDC_PROVIDER_TYPE=zitadel
OIDC_AUTO_PROVISION_USERS=true
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/api/auth/logout/callback
OIDC_SCOPES=openid profile email offline_access
ZITADEL_VERSION=stable
ZITADEL_PORT=8080
ZITADEL_MASTERKEY=
ZITADEL_POSTGRES_ADMIN_PASSWORD=
ZITADEL_BOOTSTRAP_PAT_FILE=var/zitadel/admin.pat
ZITADEL_BOOTSTRAP_PROJECT_NAME=Resource Portal
ZITADEL_BOOTSTRAP_APP_NAME=Resource Portal Web
ZITADEL_BOOTSTRAP_REDIRECT_URIS=http://localhost:3000/api/auth/callback
ZITADEL_BOOTSTRAP_POST_LOGOUT_REDIRECT_URIS=http://localhost:3000/api/auth/logout/callback
ZITADEL_BOOTSTRAP_TEST_USER_USERNAME=resource-user
ZITADEL_BOOTSTRAP_TEST_USER_EMAIL=resource-user@example.local
ZITADEL_BOOTSTRAP_TEST_USER_PASSWORD=
RESOURCE_ENCRYPTION_KEY=
MANAGED_DOMAIN_BASE=apps.resource-portal.local
RESOURCE_STORAGE_ROOT=/rp/volumes
INTERNAL_WORKER_TOKEN=dev-worker-token
DOCKER_CONTEXT=default
DOCKER_APPLY_TIMEOUT_MS=120000
DOCKER_CONFIG_PROVISION_TIMEOUT_MS=120000
DOCKER_REGISTRY_AUTH_TIMEOUT_MS=120000
DOCKER_SECRET_PROVISION_TIMEOUT_MS=120000
DOCKER_VOLUME_PROVISION_TIMEOUT_MS=120000
DOCKER_RUNTIME_OPERATION_TIMEOUT_MS=120000
DOCKER_ROLLOUT_TIMEOUT_MS=300000
DOCKER_ROLLOUT_POLL_INTERVAL_MS=5000
WORKER_ID=local-worker
WORKER_POLL_INTERVAL_MS=5000
WORKER_LEASE_SECONDS=300
WORKER_METRICS_PORT=9464
WORKER_ONCE=false
