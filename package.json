{
  "name": "resource-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Resource Portal monorepo",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @resource-portal/sdk && npm run build --workspace @resource-portal/api && npm run build --workspace @resource-portal/cli",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "api:start": "npm --workspace @resource-portal/api run start",
    "api:start:dev": "npm --workspace @resource-portal/api run start:dev",
    "api:prisma:generate": "npm --workspace @resource-portal/api run prisma:generate",
    "api:prisma:migrate": "npm --workspace @resource-portal/api run prisma:migrate",
    "api:db:seed": "npm --workspace @resource-portal/api run db:seed",
    "api:worker:deployments": "npm --workspace @resource-portal/api run worker:deployments",
    "api:smoke:deploy": "npm --workspace @resource-portal/api run smoke:deploy",
    "cli": "npm --workspace @resource-portal/cli run start --"
  }
}
