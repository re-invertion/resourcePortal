{
  "name": "@resource-portal/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "start": "NODE_ENV=production node server.mjs",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --outDir dist/server --ssr src/entry-server.tsx",
    "build": "tsc --noEmit && npm run build:client && npm run build:server",
    "lint": "tsc --noEmit && node --check server.mjs && node --check proxy-target.mjs",
    "test": "vitest run",
    "test:security": "vitest run src/security/storage.test.ts",
    "prebuild": "npm run build --workspace @resource-portal/help",
    "prelint": "npm run build --workspace @resource-portal/help",
    "pretest": "npm run build --workspace @resource-portal/help"
  },
  "dependencies": {
    "@resource-portal/help": "0.1.0",
    "@xyflow/react": "^12.12.0",
    "qrcode.react": "^4.2.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "jsdom": "30.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
