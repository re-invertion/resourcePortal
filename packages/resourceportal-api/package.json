{
  "name": "@resource-portal/api",
  "version": "0.1.0",
  "private": true,
  "description": "Resource Portal backend API",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:seed": "ts-node src/prisma/seed.ts",
    "zitadel:bootstrap": "ts-node --files scripts/bootstrap-zitadel.ts",
    "worker:deployments": "ts-node --files src/internal/deployment-worker.runner.ts",
    "worker:operations": "ts-node --files src/operations/operation-worker.runner.ts",
    "dr:reconcile": "ts-node --files src/disaster-recovery/disaster-recovery.runner.ts",
    "smoke:deploy": "ts-node --files scripts/smoke-deploy.ts",
    "smoke:stage9-ingress": "ts-node --files scripts/smoke-stage9-ingress.ts",
    "smoke:volume-lifecycle": "ts-node --files scripts/smoke-volume-lifecycle.ts",
    "smoke:stage11-quota-concurrency": "ts-node --files scripts/smoke-stage11-quota-concurrency.ts",
    "smoke:stage13-platform-infrastructure": "ts-node --files scripts/smoke-stage13-platform-infrastructure.ts",
    "smoke:stage14-storage-backend": "ts-node --files scripts/smoke-stage14-storage-backend.ts",
    "smoke:stage15-capacity": "ts-node --files scripts/smoke-stage15-capacity.ts",
    "smoke:stage16-operations": "ts-node --files scripts/smoke-stage16-operations.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.3",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/platform-fastify": "^11.1.6",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/client": "6.12.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "jose": "^6.2.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prisma": "7.10.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.40.0",
    "vitest": "^4.1.11"
  },
  "prisma": {
    "seed": "ts-node src/prisma/seed.ts"
  }
}
