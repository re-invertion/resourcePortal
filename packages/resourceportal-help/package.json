{
  "name": "@resource-portal/help",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && printf '{\"type\":\"module\"}\n' > dist/esm/package.json",
    "lint": "tsc -p tsconfig.cjs.json --noEmit && tsc -p tsconfig.esm.json --noEmit",
    "test": "node --test test/*.test.cjs"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
