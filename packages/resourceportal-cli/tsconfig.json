{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "declaration": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@resource-portal/sdk": [
        "../resourceportal-sdk/dist/full.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
