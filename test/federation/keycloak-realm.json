      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "TenantPass123!",
          "temporary": false
        }
      ]
    },
    {
      "username": "saml-user",
      "email": "saml-user@example.test",
      "firstName": "SAML",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "TenantPass123!",
          "temporary": false
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "zitadel-oidc",
