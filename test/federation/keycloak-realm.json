{
  "realm": "tenant",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "users": [
    {
      "username": "oidc-user",
      "email": "oidc-user@example.test",
      "firstName": "OIDC",
      "lastName": "User",
