{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resourceportal.local/schemas/release-manifest-v1.json",
  "type": "object",
  "required": ["schemaVersion", "version", "installer", "docker", "configSchemaVersion", "images", "migrations"],
  "properties": {
    "schemaVersion": {"const": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "installer": {"type": "object", "required": ["minimumVersion"], "properties": {"minimumVersion": {"type": "string"}}},
    "docker": {"type": "object", "required": ["minimumVersion"], "properties": {"minimumVersion": {"type": "string"}}},
    "configSchemaVersion": {"type": "integer", "minimum": 1},
    "images": {
      "type": "object",
      "required": ["api", "web", "postgres", "zitadel", "traefik"],
      "additionalProperties": false,
      "properties": {
        "api": {"type": "string"}, "web": {"type": "string"}, "postgres": {"type": "string"},
        "zitadel": {"type": "string"}, "traefik": {"type": "string"}
      }
    },
    "migrations": {
      "type": "object",
      "required": ["supportedFromVersions", "rollbackPolicy"],
      "properties": {
        "supportedFromVersions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "rollbackPolicy": {"enum": ["none", "image-only", "tested"]},
        "rollbackCertifiedSources": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"object","required":["sourceVersion","policy","reason","targetCommit","workflowRunId","kind","actualDatabaseMigration","previousImagesRestored","injectedHealthFailure","databaseSnapshotVerified","databaseSnapshotRestored","restoredSourceSchema","previousApiReadWriteAfterRollback","previousApiRuntimeReadyAfterRollback","zitadelDatabaseRestored","zitadelSourceRuntimeReadyAfterRollback","zitadelSourceEventstoreVerified","candidateZitadelRuntimeReadyBeforeRollback","candidateZitadelImage","sourceZitadelImage"],"properties":{"sourceVersion":{"type":"string"},"policy":{"enum":["image-only","tested"]},"reason":{"type":"string"},"targetCommit":{"type":"string","pattern":"^[a-f0-9]{40}$"},"workflowRunId":{"type":"integer","minimum":1},"kind":{"const":"real-upgrade-and-restore"},"actualDatabaseMigration":{"const":true},"previousImagesRestored":{"const":true},"injectedHealthFailure":{"const":true},"databaseSnapshotVerified":{"const":true},"databaseSnapshotRestored":{"const":true},"restoredSourceSchema":{"const":true},"previousApiReadWriteAfterRollback":{"const":true},"previousApiRuntimeReadyAfterRollback":{"const":true},"zitadelDatabaseRestored":{"const":true},"zitadelSourceRuntimeReadyAfterRollback":{"const":true},"zitadelSourceEventstoreVerified":{"const":true},"candidateZitadelRuntimeReadyBeforeRollback":{"const":true},"candidateZitadelImage":{"type":"string"},"sourceZitadelImage":{"type":"string"}}}},
        "rollbackAssessment": {
          "type": "object",
          "required": ["reason", "sourceVersion", "targetCommit"],
          "properties": {
            "reason": {"enum": ["no-resourceportal-database-schema-changes", "database-compatibility-not-verified", "milestone-requires-verified-recovery", "verified-recovery-test"]},
            "sourceVersion": {"type": "string"},
            "targetCommit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
          }
        }
      }
    }
  },
  "additionalProperties": false
}
