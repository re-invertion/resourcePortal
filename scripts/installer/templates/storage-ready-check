#!/usr/bin/env bash
set -euo pipefail

config_path="${1:-/etc/resourceportal/installer.conf}"
[[ -r "$config_path" ]] || { echo "missing installer config" >&2; exit 1; }
# shellcheck disable=SC1090
source "$config_path"
base="${RP_CFG_STORAGE_BASE_PATH:-/srv/resource-portal/storage}"

filesystem="$(findmnt -nro FSTYPE -T "$base")"
options="$(findmnt -nro OPTIONS -T "$base")"
case "$filesystem" in xfs|ext4) ;; *) echo "unsupported filesystem: $filesystem" >&2; exit 1 ;; esac
[[ ",$options," == *,prjquota,* || ",$options," == *,pquota,* ]] || {
  echo "project quota mount option missing" >&2
  exit 1
}

for path in \
  "$base/volumes" \
  "$base/secrets" \
  "$base/platform" \
  "$base/platform/databases/resourceportal-postgres" \
  "$base/platform/databases/zitadel-postgres"; do
  [[ -d "$path" ]] || { echo "missing storage path: $path" >&2; exit 1; }
done

if [[ "$filesystem" == "ext4" ]]; then
  source_device="$(findmnt -nro SOURCE -T "$base")"
  features="$(tune2fs -l "$source_device" 2>/dev/null | awk -F: '/Filesystem features:/ {print $2}')"
  [[ " $features " == *" project "* && " $features " == *" quota "* ]] || {
    echo "ext4 project quota feature missing" >&2
    exit 1
  }
fi
